{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Group Kotlin and KSP bumps, which must move together",
      "matchPackagePatterns": ["^org.jetbrains.kotlin", "com.google.devtools.ksp"],
      "groupName": "kotlin"
    }
  ]
}
